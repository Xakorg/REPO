rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────
    // HELPERS
    // ─────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // ─────────────────────────────────────────────
    // USERS & SUBCOLLECTIONS
    // ─────────────────────────────────────────────
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // Notifications subcollection (Covers both get and list)
      match /notifications/{docId} {
        allow create: if isSignedIn();
        allow read, update, delete: if isOwner(userId);
      }
    }

    // ─────────────────────────────────────────────
    // ADMIN REGISTRY
    // ─────────────────────────────────────────────
    match /admins/{userId} {
      allow read: if isSignedIn();
    }

    // ─────────────────────────────────────────────
    // PUBLIC SYSTEM DATA
    // ─────────────────────────────────────────────
    match /system_stats/{id} {
      allow read: if true;
    }

    // ─────────────────────────────────────────────
    // LEADERBOARD
    // ─────────────────────────────────────────────
    match /leaderboard/{id} {
      allow read: if true;
      allow write: if isSignedIn()
        && request.resource.data.uid == request.auth.uid;
    }

    // ─────────────────────────────────────────────
    // NEWS
    // ─────────────────────────────────────────────
    match /news/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─────────────────────────────────────────────
    // INDEXED SITES
    // ─────────────────────────────────────────────
    match /indexedSites/{id} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // ─────────────────────────────────────────────
    // PUBLISHED PROJECTS
    // ─────────────────────────────────────────────
    match /publishedProjects/{id} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // ─────────────────────────────────────────────
    // VIDEOS + COMMENTS
    // ─────────────────────────────────────────────
    match /videos/{id} {
      allow read: if true;
      allow write: if isSignedIn();

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isSignedIn();
      }
    }

    // ─────────────────────────────────────────────
    // CONTACT MESSAGES
    // ─────────────────────────────────────────────
    match /contact_messages/{msgId} {
      allow create: if isSignedIn();
      allow read, update, delete: if isAdmin();
    }

    // ─────────────────────────────────────────────
    // MEETINGS
    // ─────────────────────────────────────────────
    match /meetings/{meetingId} {
      allow read, write: if isSignedIn();
    }

    // ─────────────────────────────────────────────
    // GLOBAL SOCIAL DATA
    // ─────────────────────────────────────────────
    match /globalMessages/{id} {
      allow read: if true;
      allow create: if isSignedIn();
    }

    match /global_feed/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /global_notifications/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─────────────────────────────────────────────
    // GROUPS / SOCIAL GRAPH
    // ─────────────────────────────────────────────
    match /groups/{id} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /buddies/{id} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // ─────────────────────────────────────────────
    // WHITEBOARDS
    // ─────────────────────────────────────────────
    match /whiteboards/{id} {
      allow read, write: if isSignedIn();
    }
  }
}