rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────
    // HELPERS
    // ─────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }


    // ─────────────────────────────────────────────
    // USERS
    // ─────────────────────────────────────────────
    match /users/{userId} {

      allow read, write: if isOwner(userId);

      match /{allPaths=**} {
        allow read, write: if isOwner(userId);
      }

      // ✅ FIXED NOTIFICATIONS
      match /notifications/{docId} {

        allow create: if isSignedIn();

        // IMPORTANT: read covers BOTH get + list
        allow read: if isOwner(userId);

        allow update, delete: if isOwner(userId);
      }
    }


    // ─────────────────────────────────────────────
    // ADMIN REGISTRY
    // ─────────────────────────────────────────────
    match /admins/{userId} {
      allow read: if isSignedIn();
    }


    // ─────────────────────────────────────────────
    // PUBLIC SYSTEM DATA
    // ─────────────────────────────────────────────
    match /system_stats/{id} {
      allow read: if true;
    }

    match /system_stats {
      allow read: if true;
    }


    // ─────────────────────────────────────────────
    // LEADERBOARD
    // ─────────────────────────────────────────────
    match /leaderboard/{id} {

      allow read: if true;

      allow write: if isSignedIn()
        && request.resource.data.uid == request.auth.uid;
    }

    match /leaderboard {
      allow read: if true;
    }


    // ─────────────────────────────────────────────
    // NEWS
    // ─────────────────────────────────────────────
    match /news/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /news {
      allow read: if true;
    }


    // ─────────────────────────────────────────────
    // INDEXED SITES
    // ─────────────────────────────────────────────
    match /indexedSites/{id} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /indexedSites {
      allow read: if true;
    }


    // ─────────────────────────────────────────────
    // PUBLISHED PROJECTS
    // ─────────────────────────────────────────────
    match /publishedProjects/{id} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /publishedProjects {
      allow read: if true;
    }


    // ─────────────────────────────────────────────
    // VIDEOS + COMMENTS
    // ─────────────────────────────────────────────
    match /videos/{id} {

      allow read: if true;
      allow write: if isSignedIn();

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isSignedIn();
      }
    }

    match /videos {
      allow read: if true;
    }


    // ─────────────────────────────────────────────
    // CONTACT MESSAGES
    // ─────────────────────────────────────────────
    match /contact_messages/{msgId} {

      allow create: if isSignedIn();

      allow read, update, delete: if isAdmin();
    }

    match /contact_messages {
      allow read: if isAdmin();
    }


    // ─────────────────────────────────────────────
    // MEETINGS
    // ─────────────────────────────────────────────
    match /meetings/{meetingId} {

      allow read, write: if isSignedIn();

      match /{allPaths=**} {
        allow read, write: if isSignedIn();
      }
    }


    // ─────────────────────────────────────────────
    // GLOBAL SOCIAL DATA
    // ─────────────────────────────────────────────
    match /globalMessages/{id} {
      allow read: if true;
      allow create: if isSignedIn();
    }

    match /globalMessages {
      allow read: if true;
    }


    match /global_feed/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /global_feed {
      allow read: if true;
    }


    match /global_notifications/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /global_notifications {
      allow read: if true;
    }


    // ─────────────────────────────────────────────
    // GROUPS / SOCIAL GRAPH
    // ─────────────────────────────────────────────
    match /groups/{id} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /groups {
      allow read: if true;
    }


    match /buddies/{id} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /buddies {
      allow read: if true;
    }


    // ─────────────────────────────────────────────
    // WHITEBOARDS
    // ─────────────────────────────────────────────
    match /whiteboards/{id} {

      allow read, write: if isSignedIn();

      match /{allPaths=**} {
        allow read, write: if isSignedIn();
      }
    }
  }
}