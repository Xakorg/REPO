rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── HELPERS ──────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }
    function isAdmin() {
      return request.auth != null &&
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) || 
         request.auth.token.email.matches('.*@xakteir\\.com'));
    }

    // ─── USER DATA ───────────────────────────────────────────────────────
    match /users/{userId} {
      allow read, write: if isOwner(userId);
      
      match /{allPaths=**} {
        allow read, write: if isOwner(userId);
      }
      
      // Allow system or other users to send notifications
      match /notifications/{id} {
        allow create: if isSignedIn();
        allow read, update, delete: if isOwner(userId);
      }
    }

    // ─── ADMIN REGISTRY ───────────────────────────────────────────────────
    match /admins/{userId} {
      allow read: if isSignedIn();
    }

    // ─── PUBLIC COLLECTIONS ───────────────────────────────────────────────
    match /system_stats/{id} { allow read: if true; }
    match /system_stats { allow read: if true; }
    
    match /leaderboard/{id} { allow read: if true; allow write: if isSignedIn(); }
    match /leaderboard { allow read: if true; }
    
    match /news/{id} { allow read: if true; allow write: if isAdmin(); }
    match /news { allow read: if true; }
    
    match /indexedSites/{id} { allow read: if true; allow write: if isSignedIn(); }
    match /indexedSites { allow read: if true; }
    
    match /publishedProjects/{id} { allow read: if true; allow write: if isSignedIn(); }
    match /publishedProjects { allow read: if true; }
    
    match /videos/{id} { 
      allow read: if true; 
      allow write: if isSignedIn(); 
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isSignedIn();
      }
    }
    match /videos { allow read: if true; }

    // ─── SUPPORT REGISTRY ─────────────────────────────────────────────────
    match /contact_messages/{msgId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
    match /contact_messages {
      allow read: if isAdmin();
    }

    // ─── MEETINGS ────────────────────────────────────────────────────────
    match /meetings/{meetingId} {
      allow read, write: if isSignedIn();
      match /{allPaths=**} {
        allow read, write: if isSignedIn();
      }
    }

    // ─── SOCIAL & GROUPS ──────────────────────────────────────────────────
    match /globalMessages/{id} { allow read: if true; allow create: if isSignedIn(); }
    match /globalMessages { allow read: if true; }
    
    match /global_feed/{id} { allow read: if true; allow write: if isAdmin(); }
    match /global_feed { allow read: if true; }
    
    match /global_notifications/{id} { allow read: if true; allow write: if isAdmin(); }
    match /global_notifications { allow read: if true; }
    
    match /groups/{id} { allow read: if true; allow write: if isSignedIn(); }
    match /groups { allow read: if true; }
    
    match /buddies/{id} { allow read: if true; allow write: if isSignedIn(); }
    match /buddies { allow read: if true; }
    
    match /whiteboards/{id} {
      allow read, write: if isSignedIn();
      match /{allPaths=**} {
        allow read, write: if isSignedIn();
      }
    }
  }
}