rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────
    // HELPERS
    // ─────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn()
        && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(
          /databases/$(database)/documents/admins/$(request.auth.uid)
        );
    }

    function hasValidUid() {
      return request.resource.data.uid is string
        && request.resource.data.uid == request.auth.uid;
    }

    function resourceOwned() {
      return resource.data.uid is string
        && resource.data.uid == request.auth.uid;
    }

    // ─────────────────────────────────────────────
    // USERS
    // ─────────────────────────────────────────────

    match /users/{userId} {

      allow read, write: if isOwner(userId);

      // ─────────────────────────────────────────
      // NOTIFICATIONS
      // ─────────────────────────────────────────

      match /notifications/{docId} {

        // FIXED: Explicit list and get permissions
        allow list, get: if isOwner(userId);

        allow create: if isOwner(userId)
          && hasValidUid();

        allow update, delete: if isOwner(userId)
          && resourceOwned();
      }
      
      // ─────────────────────────────────────────
      // CHAT MESSAGES
      // ─────────────────────────────────────────
      
      match /messages/{messageId} {
        allow list, get: if isOwner(userId);
        allow create: if isOwner(userId) && hasValidUid();
        allow update, delete: if isOwner(userId) && resourceOwned();
      }
    }

    // ─────────────────────────────────────────────
    // ADMINS
    // ─────────────────────────────────────────────

    match /admins/{userId} {

      allow get: if isAdmin();

      allow list: if false;

      allow create, update, delete: if isAdmin();
    }

    // ─────────────────────────────────────────────
    // SYSTEM STATS
    // ─────────────────────────────────────────────

    match /system_stats/{id} {
      allow read: if true;
    }

    // ─────────────────────────────────────────────
    // LEADERBOARD
    // ─────────────────────────────────────────────

    match /leaderboard/{id} {

      allow read: if true;

      allow create, update: if isSignedIn()
        && hasValidUid();

      allow delete: if isAdmin();
    }

    // ─────────────────────────────────────────────
    // NEWS
    // ─────────────────────────────────────────────

    match /news/{id} {

      allow read: if true;

      allow write: if isAdmin();
    }

    // ─────────────────────────────────────────────
    // INDEXED SITES
    // ─────────────────────────────────────────────

    match /indexedSites/{id} {

      allow read: if true;

      allow create: if isSignedIn();

      allow update, delete: if isAdmin();
    }

    // ─────────────────────────────────────────────
    // PUBLISHED PROJECTS
    // ─────────────────────────────────────────────

    match /publishedProjects/{id} {

      allow read: if true;

      allow create: if isSignedIn()
        && hasValidUid();

      allow update, delete: if isSignedIn()
        && resourceOwned();
    }

    // ─────────────────────────────────────────────
    // VIDEOS
    // ─────────────────────────────────────────────

    match /videos/{id} {

      allow read: if true;

      allow create: if isSignedIn();

      allow update, delete: if isAdmin();

      match /comments/{commentId} {

        allow read: if true;

        allow create: if isSignedIn()
          && hasValidUid();

        allow update, delete: if isSignedIn()
          && resourceOwned();
      }
    }

    // ─────────────────────────────────────────────
    // CONTACT MESSAGES
    // ─────────────────────────────────────────────

    match /contact_messages/{msgId} {

      allow create: if isSignedIn();

      allow get, list, update, delete: if isAdmin();
    }

    // ─────────────────────────────────────────────
    // MEETINGS
    // ─────────────────────────────────────────────

    match /meetings/{meetingId} {

      allow read, update, delete: if isSignedIn()
        && request.auth.uid in resource.data.participants;

      allow create: if isSignedIn()
        && request.auth.uid in request.resource.data.participants;
    }

    // ─────────────────────────────────────────────
    // GLOBAL MESSAGES
    // ─────────────────────────────────────────────

    match /globalMessages/{id} {

      allow read: if true;

      allow create: if isSignedIn()
        && hasValidUid();

      allow update, delete: if isAdmin();
    }

    // ─────────────────────────────────────────────
    // GLOBAL FEED
    // ─────────────────────────────────────────────

    match /global_feed/{id} {

      allow read: if true;

      allow write: if isAdmin();
    }

    // ─────────────────────────────────────────────
    // GLOBAL NOTIFICATIONS
    // ─────────────────────────────────────────────

    match /global_notifications/{id} {

      allow read: if true;

      allow write: if isAdmin();
    }

    // ─────────────────────────────────────────────
    // GROUPS
    // ─────────────────────────────────────────────

    match /groups/{id} {

      allow read: if true;

      allow create: if isSignedIn();

      allow update, delete: if isSignedIn()
        && resource.data.ownerId == request.auth.uid;
    }

    // ─────────────────────────────────────────────
    // BUDDIES
    // ─────────────────────────────────────────────

    match /buddies/{id} {

      allow read: if true;

      allow create: if isSignedIn();

      allow update, delete: if isSignedIn()
        && (
          resource.data.userA == request.auth.uid
          || resource.data.userB == request.auth.uid
        );
    }

    // ─────────────────────────────────────────────
    // WHITEBOARDS
    // ─────────────────────────────────────────────

    match /whiteboards/{id} {

      allow read: if true;
      allow create: if isSignedIn();

      allow update, delete: if isSignedIn()
        && request.auth.uid in resource.data.members;
    }
    
    // ─────────────────────────────────────────────
    // CHAT ROOMS
    // ─────────────────────────────────────────────
    
    match /chats/{chatId} {
      allow read, write: if isSignedIn()
        && request.auth.uid in resource.data.participants;
        
      match /messages/{messageId} {
        allow read, list: if isSignedIn()
          && request.auth.uid in resource.data.participants;
        allow create: if isSignedIn()
          && request.auth.uid in request.resource.data.participants;
        allow update, delete: if isSignedIn()
          && resource.data.senderId == request.auth.uid;
      }
    }
  }
}
