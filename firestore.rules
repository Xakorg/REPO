rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────
    // HELPERS
    // ─────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn()
        && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(
          /databases/$(database)/documents/admins/$(request.auth.uid)
        );
    }

    function hasValidUid() {
      return request.resource.data.uid is string
        && request.resource.data.uid == request.auth.uid;
    }

    function resourceOwned() {
      return resource.data.uid is string
        && resource.data.uid == request.auth.uid;
    }

    // ─────────────────────────────────────────────
    // USERS
    // ─────────────────────────────────────────────

    match /users/{userId} {

      // Owners or admins may read/write user documents
      allow read, write: if isOwner(userId) || isAdmin();

      // ─────────────────────────────────────────
      // NOTIFICATIONS
      // ─────────────────────────────────────────

      match /notifications/{docId} {

        // FIXED: Explicit list and get permissions
        allow list, get: if isOwner(userId);

        allow create: if isOwner(userId)
          && hasValidUid();

        allow update, delete: if isOwner(userId)
          && resourceOwned();
      }
      
      // ─────────────────────────────────────────
      // CHAT MESSAGES
      // ─────────────────────────────────────────
      
      match /messages/{messageId} {
        allow list, get: if isOwner(userId);
        allow create: if isOwner(userId) && hasValidUid();
        allow update, delete: if isOwner(userId) && resourceOwned();
      }
    }

    // ─────────────────────────────────────────────
    // ADMINS
    // ─────────────────────────────────────────────

    match /admins/{userId} {

      allow get: if isAdmin();

      allow list: if false;

      allow create, update, delete: if isAdmin();
    }

    // ─────────────────────────────────────────────
    // SYSTEM STATS
    // ─────────────────────────────────────────────

    match /system_stats/{id} {
      allow read: if true;
    }

    // System configuration (app-level settings)
    match /system/{id} {
      // Allow admins to read/write system config; allow read for all to simplify app UIs.
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─────────────────────────────────────────────
    // LEADERBOARD
    // ─────────────────────────────────────────────

    match /leaderboard/{id} {

      allow read: if true;

      allow create, update: if isSignedIn()
        && hasValidUid();

      allow delete: if isAdmin();
    }

    // ─────────────────────────────────────────────
    // NEWS
    // ─────────────────────────────────────────────

    match /news/{id} {

      allow read: if true;

      allow write: if isAdmin();
    }

    // ─────────────────────────────────────────────
    // INDEXED SITES
    // ─────────────────────────────────────────────

    match /indexedSites/{id} {

      allow read: if true;

      allow create: if isSignedIn();

      allow update, delete: if isAdmin();
    }

    // ─────────────────────────────────────────────
    // PUBLISHED PROJECTS
    // ─────────────────────────────────────────────

    match /publishedProjects/{id} {

      allow read: if true;

      allow create: if isSignedIn()
        && hasValidUid();

      allow update, delete: if isSignedIn()
        && resourceOwned();
    }

    // ─────────────────────────────────────────────
    // VIDEOS
    // ─────────────────────────────────────────────

    match /videos/{id} {

      allow read: if true;

      allow create: if isSignedIn();

      allow update, delete: if isAdmin();

      match /comments/{commentId} {

        allow read: if true;

        allow create: if isSignedIn()
          && hasValidUid();

        allow update, delete: if isSignedIn()
          && resourceOwned();
      }
    }

    // ─────────────────────────────────────────────
    // CONTACT MESSAGES
    // ─────────────────────────────────────────────

    match /contact_messages/{msgId} {

      allow create: if isSignedIn();

      allow get, list, update, delete: if isAdmin();
    }

    // ─────────────────────────────────────────────
    // MEETINGS
    // ─────────────────────────────────────────────

    match /meetings/{meetingId} {

      allow read, update, delete: if isSignedIn()
        && request.auth.uid in resource.data.participants;

      allow create: if isSignedIn()
        && request.auth.uid in request.resource.data.participants;
    }

    // ─────────────────────────────────────────────
    // GLOBAL MESSAGES
    // ─────────────────────────────────────────────

    match /globalMessages/{id} {

      allow read: if true;

      allow create: if isSignedIn()
        && hasValidUid();

      allow update, delete: if isAdmin();
    }

    // ─────────────────────────────────────────────
    // GLOBAL FEED
    // ─────────────────────────────────────────────

    match /global_feed/{id} {

      allow read: if true;

      allow write: if isAdmin();
    }

    // ─────────────────────────────────────────────
    // GLOBAL NOTIFICATIONS
    // ─────────────────────────────────────────────

    match /global_notifications/{id} {

      allow read: if true;

      allow write: if isAdmin();
    }

    // ─────────────────────────────────────────────
    // GROUPS
    // ─────────────────────────────────────────────

    match /groups/{id} {

      allow read: if true;

      allow create: if isSignedIn();

      allow update, delete: if isSignedIn()
        && resource.data.ownerId == request.auth.uid;
    }

    // ─────────────────────────────────────────────
    // BUDDIES
    // ─────────────────────────────────────────────

    match /buddies/{id} {

      allow read: if true;

      allow create: if isSignedIn();

      allow update, delete: if isSignedIn()
        && (
          resource.data.userA == request.auth.uid
          || resource.data.userB == request.auth.uid
        );
    }

    // ─────────────────────────────────────────────
    // WHITEBOARDS
    // ─────────────────────────────────────────────

    match /whiteboards/{id} {

      allow read: if true;
      allow create: if isSignedIn();

      allow update, delete: if isSignedIn()
        && request.auth.uid in resource.data.members;
    }
    
    // ─────────────────────────────────────────────
    // CHAT ROOMS
    // Robust rules for chats and messages:
    // - Users can create chats only if they're included in the participants array
    // - Chats can be listed by a client when the query filters by participants array-contains the caller
    // - Public chats are readable by anyone
    // - Messages creation requires the sender to match auth.uid and membership in the parent chat
    match /chats/{chatId} {
      // Create a chat only if the creator is included in participants
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.participants;

      // Get a single chat if it's public or the caller is a participant
      allow get: if resource.data.public == true || (isSignedIn() && request.auth.uid in resource.data.participants);

      // List chats only when the client query includes array-contains with the caller's uid,
      // or when listing public channels (client must filter accordingly).
      allow list: if (
        // allow queries that explicitly ask for chats where participants array-contains the caller
        (isSignedIn() && request.query.where('participants', 'array-contains', request.auth.uid))
        // OR allow listing public chats (client should filter by public==true)
        || (request.query.where('public', '==', true))
      );

      // Allow updates/deletes only for participants
      allow update, delete: if isSignedIn() && request.auth.uid in resource.data.participants;

      match /messages/{messageId} {
        // Read/list messages for this chat if the chat is public or the caller is a participant
        allow get, list: if (
          get(/databases/$(database)/documents/chats/$(chatId)).data.public == true
          || (isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants)
        );

        // Create message only if senderId matches auth and sender is a participant in parent chat
        allow create: if isSignedIn()
          && request.auth.uid == request.resource.data.senderId
          && (
            get(/databases/$(database)/documents/chats/$(chatId)).data.public == true
            || request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
          );

        // Update/delete allowed only to original sender
        allow update, delete: if isSignedIn() && resource.data.senderId == request.auth.uid;
      }
    }
  }
}
