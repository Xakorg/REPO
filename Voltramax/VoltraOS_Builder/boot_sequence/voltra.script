// VoltraOS Boot Animation Script
// Strict < 3 seconds boot sequence

// Set background to pure black
Window.SetBackgroundTopColor (0.0, 0.0, 0.0);
Window.SetBackgroundBottomColor (0.0, 0.0, 0.0);

// Load the logo image (we will use logo.png here)
logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.sprite.SetOpacity(0); // Start completely hidden for the initial 0.2s flash

// Position logo perfectly in the center of the screen
screen_width = Window.GetWidth();
screen_height = Window.GetHeight();
logo.x = screen_width / 2 - logo.image.GetWidth() / 2;
logo.y = screen_height / 2 - logo.image.GetHeight() / 2;
logo.sprite.SetPosition(logo.x, logo.y, 10000);

progress = 0;

// The refresh function runs constantly during boot (roughly 50 FPS)
fun refresh_callback () {
    progress++;
    
    // 0.2 second delay = ~10 frames. 
    // After 10 frames, fade in the logo rapidly.
    if (progress > 10) {
        opacity = (progress - 10) / 15.0; // Fades in over ~0.3 seconds
        if (opacity > 1) opacity = 1;
        logo.sprite.SetOpacity(opacity);
    }
}

// Bind the refresh callback to Plymouth
Plymouth.SetRefreshFunction (refresh_callback);
